{
  "name": "digital-mandal",
  "version": "0.1.0",
  "private": true,
  "description": "Production platform for Digital Mandal festival management and Digital Vargani.",
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@<2.0.0": "^1.1.17",
      "brace-expansion@>=2.0.0 <3.0.0": "^2.1.3",
      "exceljs>uuid": "^11.1.1",
      "js-yaml": "^5.2.2",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    }
  },
  "scripts": {
    "build": "pnpm --filter @digital-mandal/api build",
    "build:all": "pnpm -r build",
    "dev": "pnpm --filter @digital-mandal/web dev",
    "dev:api": "pnpm --filter @digital-mandal/api start:dev",
    "dev:web": "pnpm --filter @digital-mandal/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @digital-mandal/database prisma:generate",
    "db:migrate": "pnpm --filter @digital-mandal/database prisma:migrate",
    "db:studio": "pnpm --filter @digital-mandal/database prisma:studio",
    "demo:seed:akhilnayak": "node --env-file=.env scripts/seed-akhilnayak-demo.cjs",
    "demo:verify:akhilnayak": "node --env-file=.env scripts/verify-akhilnayak-demo.cjs",
    "db:verify:tables": "node scripts/verify-supabase-tables.cjs",
    "load:test": "k6 run scripts/load-test.js",
    "storage:migrate-receipts": "node --env-file=.env scripts/migrate-receipts-private.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.38.0"
  }
}
