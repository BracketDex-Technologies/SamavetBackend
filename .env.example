NODE_ENV=development
# Render supplies PORT automatically. API_PORT is the local/Docker fallback.
API_PORT=4000
API_GLOBAL_PREFIX=api
BODY_LIMIT=12mb
TRUST_PROXY=1
REQUEST_TIMEOUT_MS=30000
HEALTH_DB_TIMEOUT_MS=3000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
SWAGGER_ENABLED=true

PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
PUBLIC_WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Vercel runtime: Supabase transaction pooler (port 6543). Keep the per-instance
# Prisma pool bounded because Fluid Compute can run many concurrent instances.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10
# CI/migrations only: Supabase direct connection (port 5432).
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres

JWT_ACCESS_SECRET=replace-with-a-new-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_COOKIE_NAME=digital_vargani_refresh
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_MAX_AGE_MS=2592000000
AUTH_STRICT_SESSION_CHECK=true
CRON_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JOB_DRAIN_BATCH_SIZE=10

REDIS_URL=redis://localhost:6379
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=digital-vargani
SUPABASE_RECEIPT_BUCKET=digital-vargani-receipts
STORAGE_SIGNED_URL_TTL_SECONDS=3600

AUTHKEY_WHATSAPP_ENABLED=false
AUTHKEY_WHATSAPP_TEMPLATE_TYPE=media
AUTHKEY_API_KEY=
AUTHKEY_WHATSAPP_RECEIPT_WID=
AUTHKEY_WHATSAPP_COUNTRY_CODE=91
AUTHKEY_WHATSAPP_HEADER_FILE_NAME=SAMAVET ePawati
AUTHKEY_WHATSAPP_HEADER_MEDIA_URL=

# Groq Free Plan. Keep the key server-side; never expose it through Vite.
GROQ_API_KEY=
GROQ_TRANSLATION_MODEL=llama-3.3-70b-versatile

# Optional fallbacks if they are already available for your organization.
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
GOOGLE_TRANSLATE_API_KEY=
