{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "pnpm --filter @digital-mandal/api build",
  "outputDirectory": "apps/api/dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "apps/api/dist/**",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/v1/internal/jobs/drain",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
