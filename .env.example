NODE_ENV=development
# Render supplies PORT automatically. API_PORT is the local/Docker fallback.
API_PORT=4000
API_GLOBAL_PREFIX=api
BODY_LIMIT=12mb
TRUST_PROXY=1
REQUEST_TIMEOUT_MS=30000
HEALTH_DB_TIMEOUT_MS=3000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
SWAGGER_ENABLED=true

PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
PUBLIC_WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=10
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres

JWT_ACCESS_SECRET=replace-with-a-new-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

REDIS_URL=redis://localhost:6379
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=digital-vargani

AUTHKEY_WHATSAPP_ENABLED=false
AUTHKEY_WHATSAPP_TEMPLATE_TYPE=media
AUTHKEY_API_KEY=
AUTHKEY_WHATSAPP_RECEIPT_WID=
AUTHKEY_WHATSAPP_COUNTRY_CODE=91
AUTHKEY_WHATSAPP_HEADER_FILE_NAME=SAMAVET ePawati
AUTHKEY_WHATSAPP_HEADER_MEDIA_URL=
